#!/bin/bash

set -euo pipefail

bundle=$HOME/.local/share/vm-access/main.mjs
[[ -f $bundle ]] || {
    printf 'vm-access: %s is missing; run ./provision.sh dev\n' "$bundle" >&2
    exit 1
}

for bun in /opt/homebrew/bin/bun /usr/local/bin/bun; do
    if [[ -x $bun ]]; then
        exec "$bun" "$bundle" "$@"
    fi
done
printf 'vm-access: Bun is missing; run ./provision.sh dev\n' >&2
exit 1
