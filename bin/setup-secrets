# Install one secret in a Linux guest. The value arrives on stdin, so it never
# shows in a process listing, and no message here includes it.

set -euo pipefail

names="GH_TOKEN, GITHUB_APP_AUTH, CLAUDE_CODE_OAUTH_TOKEN, CODEX_AUTH or LGTMCP_CONFIG"
usage="usage: setup-secrets NAME <VALUE (NAME is $names)"

die() {
    printf 'setup-secrets: %s\n' "$*" >&2
    exit 1
}

if [[ $# -eq 1 && ($1 == -h || $1 == --help) ]]; then
    printf '%s\n' "$usage"
    exit 0
fi
[[ $# -eq 1 ]] || die "$usage"
name=$1
case $name in
GH_TOKEN | GITHUB_APP_AUTH | CLAUDE_CODE_OAUTH_TOKEN | CODEX_AUTH | LGTMCP_CONFIG) ;;
*) die "unknown secret $name; expected $names" ;;
esac
[[ -n ${HOME:-} ]] || die "HOME is not set"
[[ ! -t 0 ]] || die "$name is read from stdin; pipe it in"

umask 077
value=$(cat)
if [[ -z ${value//[[:space:]]/} ]]; then
    die "the value for $name on stdin is empty"
fi

# The file is written beside its destination and renamed into place, so a
# reader never sees a partial secret.
install_file() {
    local dir=$1 file=$2 tmp
    mkdir -p "$dir"
    chmod 700 "$dir"
    tmp=$(mktemp "$dir/.$file.XXXXXX")
    if ! printf '%s\n' "$value" >"$tmp" || ! chmod 600 "$tmp" || ! mv -f "$tmp" "$dir/$file"; then
        rm -f "$tmp"
        die "cannot write $dir/$file"
    fi
}

case $name in
GH_TOKEN)
    # No keyring daemon runs in a guest, and a token left in the environment
    # would reach every process.
    printf '%s\n' "$value" | gh auth login --hostname github.com --with-token --insecure-storage ||
        die "gh auth login failed"
    ;;
GITHUB_APP_AUTH)
    tool=$(dirname "${BASH_SOURCE[0]}")/github_app_token.py
    printf '%s\n' "$value" | "$tool" install || die "installing the GitHub authorization failed"
    ;;
CLAUDE_CODE_OAUTH_TOKEN)
    install_file "$HOME/.config/secrets" CLAUDE_CODE_OAUTH_TOKEN
    ;;
CODEX_AUTH)
    printf '%s\n' "$value" | jq -es 'length == 1 and (.[0] | type) == "object"' >/dev/null 2>&1 ||
        die "the value for CODEX_AUTH is not a JSON object"
    install_file "$HOME/.codex" auth.json
    ;;
LGTMCP_CONFIG)
    install_file "$HOME/.config/lgtmcp" config.yaml
    ;;
esac
