#!/bin/bash
set -euo pipefail

if ! git rev-parse --is-inside-work-tree &>/dev/null; then
    echo "git-add-upstream: not a git repository" >&2
    exit 1
fi

origin_url="$(git remote get-url origin 2>/dev/null)" || {
    echo "git-add-upstream: no origin remote configured" >&2
    exit 1
}

origin_url="${origin_url%.git}"

if [[ "$origin_url" =~ ^https://github\.com/([^/]+)/([^/]+)$ ]] ||
   [[ "$origin_url" =~ ^git@github\.com:([^/]+)/([^/]+)$ ]]; then
    nwo="${BASH_REMATCH[1]}/${BASH_REMATCH[2]}"
else
    exit 0
fi

if ! command -v gh &>/dev/null; then
    exit 0
fi

parent_url="$(gh repo view "$nwo" --json parent \
    --jq 'if .parent then "https://github.com/" + .parent.owner.login + "/" + .parent.name + ".git" else empty end')" || {
    echo "git-add-upstream: gh api call failed" >&2
    exit 1
}

if [[ -z "$parent_url" ]]; then
    exit 0
fi

existing="$(git remote get-url upstream 2>/dev/null)" || existing=""

if [[ -z "$existing" ]]; then
    git remote add upstream "$parent_url"
    exit 0
fi

if [[ "$existing" == "$parent_url" ]]; then
    exit 0
fi

echo "git-add-upstream: upstream already set to $existing (expected $parent_url)" >&2
exit 1
