# Build and use throwaway Lima VMs. This runs on the Mac under bash 3.2, so no
# mapfile, associative arrays, lowercase expansions or empty-array expansions.

# The single-quoted scripts passed to sh -c expand in the guest.
# shellcheck disable=SC2016

set -euo pipefail

base=${LIMAVM_BASE:-dotfiles-base}
dotfiles_repo=shields/dotfiles
guest_repo=src/github.com/$dotfiles_repo
github_web_url=${LIMAVM_GITHUB_WEB_URL:-https://github.com}

die() {
    printf 'limavm: %s\n' "$*" >&2
    exit 1
}

[[ -n ${HOME:-} ]] || die "HOME is not set"
claude_token_file=$HOME/.config/secrets/CLAUDE_CODE_OAUTH_TOKEN
codex_auth_file=$HOME/.codex/auth.json

usage() {
    cat <<EOF
usage: limavm base [MODULE...]   build $base from lima/dev.yaml and the checkout in the current directory
       limavm new [NAME] [--repo OWNER/REPO | --no-repo] [--no-claude-token] [--no-codex-auth]
                                 clone $base, install secrets, clone the repository, open a shell
       limavm github NAME [OWNER/REPO]
                                 grant an additional repository through the Mac gateway
       limavm claude-token       keep the token that claude setup-token prints, for every later new
       limavm rm NAME            delete a VM ($base is refused)
       limavm list               list the VMs

MODULE is a Brewfile module for provision.sh (dev by default).
LIMAVM_CPUS and LIMAVM_MEMORY (in GiB) override the size in lima/dev.yaml, and
LIMAVM_BASE replaces the name $base. LIMAVM_GITHUB_WEB_URL, LIMAVM_GITHUB_API_URL
and LIMAVM_GITHUB_CLIENT_ID replace GitHub's addresses and the app's client ID.

The repository is --repo's, or else the one that the git origin of the current
directory names, when it is on $github_web_url. The Mac gateway performs the
GitHub App device flow when that repository lacks an authorization. Credentials
stay on the Mac. new clones the repository in the VM at
~/src/github.com/OWNER/REPO ($dotfiles_repo is already in $base), and opens
the shell there. With no repository, or with --no-repo, the VM has no GitHub
grant. Use vm-access to inspect or change grants while a VM runs.

new installs the Claude token from $claude_token_file
when that file exists, and otherwise asks for it without echo: run claude
setup-token in another terminal first. claude-token asks the same way and writes
the file (mode 600), so that new never asks again. --no-claude-token skips the
token, for a VM that will use claude auth login.

new copies this Mac's Codex login, $codex_auth_file, into the VM, and
fails when there is none: run codex login here first, with
cli_auth_credentials_store = "file" in ~/.codex/config.toml, since with keyring
or auto the login is in the OS credential store and no file exists.
--no-codex-auth skips it, for a VM that will use codex login --device-auth.
EOF
}

need() {
    command -v "$1" >/dev/null || die "$1 is not installed"
}

valid_name() {
    [[ $1 =~ ^[A-Za-z0-9]+([._-][A-Za-z0-9]+)*$ ]] || die "invalid VM name: $1"
}

valid_repository() {
    [[ $1 =~ ^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$ && $1 != ./* && $1 != ../* && $1 != */. && $1 != */.. ]] ||
        die "invalid repository, expected OWNER/REPO: $1"
}

lowercase() {
    printf '%s' "$1" | tr '[:upper:]' '[:lower:]'
}

github_host() {
    local host=${github_web_url#*://}
    host=${host%%/*}
    host=${host##*@}
    lowercase "${host%%:*}"
}

# The caller validates the result, since a die here would end only the $(...)
# subshell that reads it.
origin_repository() {
    local url rest authority path
    git rev-parse --show-toplevel >/dev/null 2>&1 || return 1
    url=$(git remote get-url origin 2>/dev/null) || return 1
    case $url in
    git@*:*)
        rest=${url#git@}
        authority=${rest%%:*}
        path=${rest#*:}
        ;;
    ssh://git@*/*)
        rest=${url#ssh://git@}
        authority=${rest%%/*}
        path=${rest#*/}
        ;;
    https://*/*)
        rest=${url#https://}
        authority=${rest%%/*}
        path=${rest#*/}
        ;;
    *) return 1 ;;
    esac
    authority=$(lowercase "${authority%%:*}")
    [[ $authority == "$(github_host)" ]] || return 1
    path=${path#/}
    path=${path%/}
    path=${path%.git}
    printf '%s\n' "$path"
}

instance_exists() {
    # limactl list exits non-zero when no instance matches the name.
    limactl list -q "$1" >/dev/null 2>&1 </dev/null
}

guest_home_of() {
    local home
    home=$(limactl shell "$1" sh -c 'printf %s "$HOME"' </dev/null)
    [[ $home == /* ]] || die "cannot tell the home directory in $1"
    printf '%s\n' "$home"
}

size_args=()
set_size_args() {
    if [[ -n ${LIMAVM_CPUS:-} ]]; then
        [[ $LIMAVM_CPUS =~ ^[1-9][0-9]*$ ]] || die "LIMAVM_CPUS must be a whole number"
        size_args+=(--cpus "$LIMAVM_CPUS")
    fi
    if [[ -n ${LIMAVM_MEMORY:-} ]]; then
        [[ $LIMAVM_MEMORY =~ ^[1-9][0-9]*$ ]] || die "LIMAVM_MEMORY must be a whole number of GiB"
        size_args+=(--memory "$LIMAVM_MEMORY")
    fi
}

stage=
base_started=0
base_finished=0
base_cleanup() {
    local status=$?
    trap - EXIT
    [[ -z $stage ]] || rm -rf "$stage"
    if ((base_started && ! base_finished)); then
        printf 'limavm: building %s failed; it is left for inspection (limactl shell %s), and limavm base replaces it\n' "$base" "$base" >&2
    fi
    exit "$status"
}

cmd_base() {
    need limactl
    need git
    need tar
    set_size_args
    local root origin authority
    root=$(git rev-parse --show-toplevel 2>/dev/null) || die "run this inside a dotfiles checkout"
    [[ -f $root/lima/dev.yaml && -x $root/provision.sh && -x $root/tools/stage_tree.sh &&
        -f $root/provision/throwaway.sh && -f $root/provision/reset-identity.sh ]] ||
        die "$root is not a dotfiles checkout (a file under lima/, provision/ or tools/ is missing)"

    origin=$(git -C "$root" config --default '' --get remote.origin.url)
    case $origin in
    git@github.com:*) origin=https://github.com/${origin#git@github.com:} ;;
    ssh://git@github.com/*) origin=https://github.com/${origin#ssh://git@github.com/} ;;
    esac
    if [[ $origin == *://* ]]; then
        authority=${origin#*://}
        authority=${authority%%/*}
        [[ $authority != *@* ]] || die "origin must not contain credentials"
    fi
    [[ $origin != *\?* && $origin != *\#* && $origin != *[[:cntrl:]]* ]] ||
        die "origin must not contain query parameters, fragments or control characters"

    trap base_cleanup EXIT
    trap 'exit 130' INT
    trap 'exit 143' TERM
    stage=$(mktemp -d "${TMPDIR:-/tmp}/limavm.XXXXXX")
    "$root/tools/stage_tree.sh" "$stage/tree"

    git clone --quiet --no-local --no-checkout --template= "$root" "$stage/history"
    local head
    head=$(git -C "$stage/history" rev-parse --verify HEAD)
    if ! git -C "$root" symbolic-ref --quiet HEAD >/dev/null; then
        git -C "$stage/history" update-ref --no-deref HEAD "$head"
    fi
    rm -rf "$stage/tree/.git"
    mv "$stage/history/.git" "$stage/tree/.git"
    git -C "$stage/tree" config core.ignorecase false
    # Provisioning uses the index to include uncommitted files in the install.
    git -C "$stage/tree" -c core.excludesFile=/dev/null add -Af .
    # Removing a remote before scanning makes its unmerged branches unreachable.
    gitleaks git --no-banner --no-color --redact --verbose --log-level warn \
        --log-opts='--all -m' --gitleaks-ignore-path "$stage/tree" "$stage/tree" >&2 ||
        die "gitleaks found secrets in the repository history, or failed"
    if [[ -n $origin ]]; then
        git -C "$stage/tree" remote set-url origin "$origin"
    else
        git -C "$stage/tree" remote remove origin
    fi

    if instance_exists "$base"; then
        if [[ $(limactl list --format '{{.Protected}}' "$base") == true ]]; then
            limactl unprotect "$base"
        fi
        limactl delete --tty=false --force "$base"
    fi
    base_started=1
    limactl start --tty=false --name="$base" ${size_args[@]+"${size_args[@]}"} "$root/lima/dev.yaml" </dev/null

    local mounts
    mounts=$(limactl list --format '{{len .Config.Mounts}}' "$base")
    [[ $mounts == 0 ]] || die "$base mounts $mounts host directories, which ~/.lima/_config adds; a throwaway VM mounts none"

    local guest_home guest_dir
    guest_home=$(guest_home_of "$base")
    guest_dir=$guest_home/$guest_repo

    COPYFILE_DISABLE=1 tar --no-xattrs --no-acls -C "$stage/tree" -cf - . |
        limactl shell "$base" sh -c 'set -eu; rm -rf "$1"; mkdir -p "$1"; tar -xf - --no-same-owner -C "$1"' _ "$guest_dir"

    # No modules is valid: provision.sh then uses its own default. bash 3.2
    # accepts an empty "$@" under set -u, unlike an empty array.
    limactl shell --workdir "$guest_dir" "$base" ./provision.sh "$@" </dev/null
    limactl shell --workdir "$guest_dir" "$base" git reset --mixed --quiet HEAD </dev/null
    limactl shell "$base" sudo "$guest_dir/provision/throwaway.sh" --no-github-timer </dev/null
    limactl shell --workdir "$guest_dir" "$base" uv run --no-dev python tools/configure_codex.py "$guest_home/.codex/config.toml" </dev/null

    limactl shell "$base" sudo truncate -s 0 /etc/machine-id </dev/null
    limactl shell "$base" "$guest_dir/provision/reset-identity.sh" </dev/null

    limactl stop --tty=false "$base"
    # limactl shell starts the instance's user.shell, not the passwd entry, and
    # limactl edit has a --shell flag for it.
    limactl edit --tty=false "$base" --shell /usr/bin/zsh
    limactl protect "$base"
    base_finished=1
    printf 'limavm: %s is ready; make a VM with: limavm new [NAME]\n' "$base"
}

claude_token=
set_claude_token() {
    local line=$1 empty=$2 spaces=$3
    line=${line//$'\r'/}
    line=${line#"${line%%[![:space:]]*}"}
    line=${line%"${line##*[![:space:]]}"}
    [[ -n $line ]] || die "$empty"
    [[ $line != *[[:space:]]* ]] || die "$spaces"
    claude_token=$line
}

# LIMAVM_PROMPT_INPUT names a file to read instead of the terminal, for tests.
prompt_claude_token() {
    local or_else=${1:-} line=
    if [[ -n ${LIMAVM_PROMPT_INPUT:-} ]]; then
        [[ -r $LIMAVM_PROMPT_INPUT ]] || die "cannot read LIMAVM_PROMPT_INPUT"
        IFS= read -r line <"$LIMAVM_PROMPT_INPUT" || [[ -n $line ]] || true
    else
        { : </dev/tty; } 2>/dev/null ||
            die "there is no terminal to ask for the Claude token; run in a terminal$or_else"
        printf 'Paste the output of claude setup-token (no echo), then press Enter: ' >/dev/tty
        IFS= read -rs line </dev/tty || [[ -n $line ]] || true
        printf '\n' >/dev/tty
    fi
    set_claude_token "$line" \
        "the Claude token is empty; run claude setup-token in another terminal and paste its output$or_else" \
        "the Claude token has spaces in it; paste only the token"
}

read_claude_token_file() {
    local content
    [[ -f $claude_token_file ]] || die "$claude_token_file is not a regular file; remove it, or pass --no-claude-token"
    [[ -r $claude_token_file ]] || die "cannot read $claude_token_file; run limavm claude-token to replace it, or pass --no-claude-token"
    content=$(<"$claude_token_file")
    set_claude_token "$content" \
        "$claude_token_file is empty; run limavm claude-token to replace it, or pass --no-claude-token" \
        "$claude_token_file holds more than one token; run limavm claude-token to replace it"
}

cmd_claude_token() {
    [[ $# -eq 0 ]] || die "usage: limavm claude-token"
    [[ ! -e $claude_token_file || -f $claude_token_file ]] || die "$claude_token_file is not a regular file; remove it first"
    prompt_claude_token
    local dir tmp
    dir=$(dirname "$claude_token_file")
    umask 077
    mkdir -p "$dir"
    chmod 700 "$dir"
    tmp=$(mktemp "$dir/.CLAUDE_CODE_OAUTH_TOKEN.XXXXXX")
    if ! printf '%s\n' "$claude_token" >"$tmp" || ! chmod 600 "$tmp" || ! mv -f "$tmp" "$claude_token_file"; then
        rm -f "$tmp"
        die "cannot write $claude_token_file"
    fi
    printf 'limavm: the Claude token is in %s; limavm new installs it from there\n' "$claude_token_file"
}

install_secret() {
    limactl shell "$1" sh -c 'exec "$HOME/bin/setup-secrets" "$1"' _ "$2"
}

created=
registered=0
new_cleanup() {
    local status=$?
    trap - EXIT
    if [[ -n $created && $status -ne 0 ]]; then
        printf 'limavm: removing %s after the failure\n' "$created" >&2
        if ((registered)); then
            vm-access disable "lima:$created" ||
                printf 'limavm: could not disable GitHub access for %s; run: vm-access disable lima:%s\n' "$created" "$created" >&2
        fi
        limactl delete --tty=false --force "$created" ||
            printf 'limavm: could not delete %s; run: limactl delete --force %s\n' "$created" "$created" >&2
    fi
    exit "$status"
}

cmd_new() {
    local name='' named=0 repo='' no_claude_token=0 no_codex_auth=0 have_repo=0 no_repo=0
    local new_usage="usage: limavm new [NAME] [--repo OWNER/REPO | --no-repo] [--no-claude-token] [--no-codex-auth]"
    while (($#)); do
        case $1 in
        --repo)
            [[ $# -ge 2 ]] || die "--repo needs OWNER/REPO"
            repo=$2
            have_repo=1
            shift 2
            ;;
        --repo=*)
            repo=${1#--repo=}
            have_repo=1
            shift
            ;;
        --no-repo)
            no_repo=1
            shift
            ;;
        --no-claude-token)
            no_claude_token=1
            shift
            ;;
        --no-codex-auth)
            no_codex_auth=1
            shift
            ;;
        -*) die "unknown option $1" ;;
        *)
            ((! named)) || die "$new_usage"
            name=$1
            named=1
            shift
            ;;
        esac
    done
    ((named)) || name=vm-$(date +%y%m%d-%H%M%S)
    valid_name "$name"
    [[ $name != "$base" ]] || die "$name is the base VM; choose another name"
    ((! have_repo || ! no_repo)) || die "--repo and --no-repo exclude each other"
    if ((have_repo)); then
        valid_repository "$repo"
    elif ((! no_repo)); then
        need git
        if repo=$(origin_repository); then
            printf 'limavm: GitHub access for %s, from the origin of this checkout (--no-repo gives none)\n' "$repo" >&2
            valid_repository "$repo"
        fi
    fi
    need limactl
    need vm-access
    need jq
    vm-access health >/dev/null || die "the GitHub gateway is not running; run ./provision.sh dev"
    set_size_args
    instance_exists "$base" || die "$base does not exist; run limavm base in a dotfiles checkout first"
    ! instance_exists "$name" || die "$name already exists"
    local lgtmcp_config=$HOME/.config/lgtmcp/config.yaml
    [[ -f $lgtmcp_config && -r $lgtmcp_config ]] || die "cannot read $lgtmcp_config; LGTMCP needs it in the VM"
    if ((! no_codex_auth)); then
        need jq
        [[ -e $codex_auth_file ]] || die "$codex_auth_file does not exist; Codex keeps its login in the OS credential store when cli_auth_credentials_store in ~/.codex/config.toml is keyring or auto: set it to \"file\" and run codex login on this Mac, or pass --no-codex-auth"
        [[ -f $codex_auth_file ]] || die "$codex_auth_file is not a regular file; remove it, or pass --no-codex-auth"
        [[ -r $codex_auth_file ]] || die "cannot read $codex_auth_file; run codex login on this Mac again, or pass --no-codex-auth"
        [[ -s $codex_auth_file ]] || die "$codex_auth_file is empty; run codex login on this Mac again, or pass --no-codex-auth"
        jq -es 'length == 1 and (.[0] | type) == "object"' "$codex_auth_file" >/dev/null 2>&1 ||
            die "$codex_auth_file is not a JSON object; run codex login on this Mac again, or pass --no-codex-auth"
    fi

    # What needs the person comes before the clone, so that waiting for them
    # leaves no VM running.
    if ((no_claude_token)); then
        :
    elif [[ -e $claude_token_file ]]; then
        read_claude_token_file
    else
        prompt_claude_token ', run limavm claude-token once, or pass --no-claude-token'
        printf 'limavm: limavm claude-token keeps the token for next time\n' >&2
    fi
    [[ -z $repo ]] || vm-access ensure-auth "$repo"

    trap new_cleanup EXIT
    trap 'exit 130' INT
    trap 'exit 143' TERM
    created=$name
    # limactl clone takes limactl edit's --cpus and --memory.
    limactl clone --tty=false ${size_args[@]+"${size_args[@]}"} "$base" "$name" </dev/null
    local registration vm_id host_socket socket_name port_rule guest_home ca_path lima_dir
    lima_dir=$(limactl list --format '{{.Dir}}' "$name") || die "cannot find the Lima directory of $name"
    [[ $lima_dir == /* ]] || die "invalid Lima directory for $name"
    install -d -m 700 "$lima_dir/sock"
    registration=$(vm-access register "lima:$name" --lima-dir "$lima_dir") || die "cannot register $name with the GitHub gateway"
    registered=1
    vm_id=$(printf '%s' "$registration" | jq -er .id) || die "the GitHub gateway returned no VM identity"
    host_socket=$(printf '%s' "$registration" | jq -er .socket) || die "the GitHub gateway returned no socket"
    socket_name=${host_socket##*/}
    [[ $socket_name =~ ^github-[0-9a-f-]+\.sock$ ]] || die "the GitHub gateway returned an invalid socket"
    port_rule='.portForwards = [{"guestSocket":"/tmp/vm-access-github.sock","hostSocket":"{{.Dir}}/sock/'"$socket_name"'","reverse":true}] + .portForwards'
    limactl edit --tty=false --set "$port_rule" "$name" </dev/null
    limactl start --tty=false "$name" </dev/null

    # The upgrade comes before any secret, so nothing it runs can read one.
    # Homebrew on Linux has casks for both agents.
    limactl shell "$name" /home/linuxbrew/.linuxbrew/bin/brew upgrade --cask claude-code@latest codex </dev/null

    guest_home=$(guest_home_of "$name")
    ca_path=$(vm-access ca-path) || die "cannot find the gateway CA certificate"
    limactl shell "$name" sudo "$guest_home/bin/setup-github-gateway" "$vm_id" <"$ca_path"
    limactl shell "$name" curl --fail --silent --show-error --max-time 10 --noproxy '*' \
        --output /dev/null https://api.github.com/__vm_access__/health </dev/null

    local guest_dir='' cloned=0
    if [[ -n $repo ]]; then
        vm-access grant "lima:$name" "$repo" --profile task
        limactl shell "$name" curl --fail --silent --show-error --max-time 20 --noproxy '*' \
            --output /dev/null "https://api.github.com/repos/$repo" </dev/null
        # The base holds that checkout already, with the Mac's local changes.
        if [[ $(lowercase "$repo") == "$dotfiles_repo" ]]; then
            guest_dir=$guest_home/$guest_repo
        else
            guest_dir=$guest_home/src/github.com/$repo
            limactl shell "$name" env GIT_TERMINAL_PROMPT=0 git clone --quiet "$github_web_url/$repo.git" "$guest_dir" </dev/null
            cloned=1
        fi
    fi
    if ((! no_claude_token)); then
        printf '%s\n' "$claude_token" | install_secret "$name" CLAUDE_CODE_OAUTH_TOKEN
    fi
    if ((! no_codex_auth)); then
        install_secret "$name" CODEX_AUTH <"$codex_auth_file"
    fi
    install_secret "$name" LGTMCP_CONFIG <"$lgtmcp_config"

    printf 'limavm: %s is ready.\n' "$name"
    if ((cloned)); then
        printf 'limavm: GitHub access: %s, with reads and pushes to task/%s/*; it is cloned at %s.\n' "$repo" "$vm_id" "$guest_dir"
    elif [[ -n $repo ]]; then
        printf 'limavm: GitHub access: %s, with reads and pushes to task/%s/*; the checkout from %s is at %s.\n' "$repo" "$vm_id" "$base" "$guest_dir"
    else
        printf 'limavm: %s has no GitHub access; limavm github %s OWNER/REPO gives it some.\n' "$name" "$name"
    fi
    if ((no_claude_token)); then
        printf 'limavm: no Claude token was installed; run claude auth login in the VM.\n'
    fi
    if ((no_codex_auth)); then
        cat <<EOF
limavm: Codex is not signed in; run

    codex login --device-auth

in the VM, after turning on device code login in ChatGPT's security settings.
EOF
    fi
    created=
    registered=0
    trap - EXIT
    if [[ -n $guest_dir ]]; then
        exec limactl shell --workdir "$guest_dir" "$name"
    fi
    exec limactl shell "$name"
}

cmd_github() {
    [[ $# -eq 1 || $# -eq 2 ]] || die "usage: limavm github NAME [OWNER/REPO]"
    local name=$1 repo=${2:-}
    valid_name "$name"
    [[ $name != "$base" ]] || die "$name is the base VM; it gets no GitHub access"
    if [[ -z $repo ]]; then
        need git
        repo=$(origin_repository) ||
            die "the current directory has no git origin on $(github_host); run limavm github $name OWNER/REPO"
        printf 'limavm: GitHub access for %s, from the origin of this checkout\n' "$repo" >&2
    fi
    valid_repository "$repo"
    need limactl
    need vm-access
    instance_exists "$name" || die "$name does not exist"
    vm-access grant "lima:$name" "$repo" --profile task
    printf 'limavm: %s can now read and push task branches on %s.\n' "$name" "$repo"
}

cmd_rm() {
    [[ $# -eq 1 ]] || die "usage: limavm rm NAME"
    valid_name "$1"
    [[ $1 != "$base" ]] || die "refusing to delete $base; limavm base rebuilds it"
    need limactl
    need vm-access
    vm-access disable "lima:$1"
    limactl delete --tty=false --force "$1"
    printf 'limavm: %s is deleted and its GitHub grants are disabled.\n' "$1"
}

cmd_list() {
    need limactl
    limactl list
}

valid_name "$base"
if [[ $# -eq 0 ]]; then
    usage >&2
    exit 2
fi
command=$1
shift
case $command in
base) cmd_base "$@" ;;
new) cmd_new "$@" ;;
github) cmd_github "$@" ;;
claude-token) cmd_claude_token "$@" ;;
rm) cmd_rm "$@" ;;
list)
    [[ $# -eq 0 ]] || die "usage: limavm list"
    cmd_list
    ;;
-h | --help | help) usage ;;
*)
    usage >&2
    exit 2
    ;;
esac
