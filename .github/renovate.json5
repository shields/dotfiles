{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: ["config:best-practices", ":semanticCommitsDisabled"],
  // Automerge waits for passing checks; Renovate counts a branch with none as
  // not green.
  platformAutomerge: true,
  packageRules: [
    {
      description: "Automerge non-major updates",
      matchUpdateTypes: ["minor", "patch", "pin", "digest"],
      automerge: true,
    },
    {
      description: "Automerge dev dependencies",
      // Rules apply independently, so this one also merges major updates: dev
      // dependencies can't break production. pep621 gives every
      // [dependency-groups] entry the depType "dependency-groups", whatever
      // the group is named.
      matchDepTypes: ["devDependencies", "dependency-groups"],
      automerge: true,
    },
    {
      description: "Keep TypeScript within what typescript-eslint supports",
      // Newer TypeScript stops ESLint from loading its configuration. Lift this
      // when typescript-eslint's peer range includes the new version.
      matchPackageNames: ["typescript"],
      allowedVersions: "<6.1.0",
    },
    {
      description: "Hold new GitHub Actions releases for three days",
      // Renovate withholds an update with no release time indefinitely, and
      // container registries give none, so the hold is limited to GitHub
      // sources. These include the uv version that setup-uv takes from a
      // release.
      matchManagers: ["github-actions"],
      matchDatasources: ["github-tags", "github-releases"],
      minimumReleaseAge: "3 days",
    },
  ],
}
