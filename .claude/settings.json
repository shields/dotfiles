{
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "CLAUDE_CODE_MAX_WEB_SEARCHES_PER_SESSION": "2000",
    "DISABLE_AUTOUPDATER": "1",
    "DISABLE_TELEMETRY": "1"
  },
  "includeCoAuthoredBy": false,
  "permissions": {
    "allow": [
      "Bash(gh issue list *)",
      "Bash(gh issue view *)",
      "Bash(gh pr list *)",
      "Bash(gh pr view *)",
      "Bash(gh release list *)",
      "Bash(gh release view *)",
      "Bash(gh repo list *)",
      "Bash(gh repo view *)",
      "Bash(gh run list *)",
      "Bash(gh run view *)",
      "Bash(gh workflow list *)",
      "Bash(gh workflow view *)",
      "Bash(git add *)",
      "Bash(git diff *)",
      "Bash(git stash *)",
      "Bash(go doc *)",
      "Bash(go mod tidy:*)",
      "Bash(* --version)",
      "Bash(* --help *)",
      "WebSearch",
      "Bash(make coverage)",
      "Bash(make lint)",
      "Bash(make test)",
      "Bash(bun test *)",
      "Bash(uv run pytest *)",
      "Bash(uv run ruff check *)",
      "Bash(uv run ty check *)"
    ],
    "deny": [
      "Bash(git commit --no-verify *)",
      "Bash(git commit -n*)",
      "Bash(git commit *--no-verify*)",
      "Bash(git * commit -n*)",
      "Bash(git * --no-verify*)",
      "Bash(git -c *commit*)",
      "Bash(git push*)",
      "Bash(git -C * push*)",
      "Bash(git -c * push*)",
      "Bash(git --git-dir* push*)",
      "Bash(git --work-tree* push*)",
      "Bash(gh api --method*)",
      "Bash(gh api -X*)",
      "Bash(gh api * --method*)",
      "Bash(gh api * -X*)",
      "Bash(gh repo archive*)",
      "Bash(gh repo autolink create*)",
      "Bash(gh repo autolink delete*)",
      "Bash(gh repo create*)",
      "Bash(gh repo delete*)",
      "Bash(gh repo deploy-key add*)",
      "Bash(gh repo deploy-key delete*)",
      "Bash(gh repo edit*)",
      "Bash(gh repo fork*)",
      "Bash(gh repo rename*)",
      "Bash(gh repo sync*)",
      "Bash(gh repo unarchive*)",
      "Bash(kubectl get secret *)",
      "Bash(kubectl get secrets *)",
      "Bash(lefthook uninstall)"
    ],
    "ask": [
      "Bash(brew bundle:*)",
      "Bash(brew install *)",
      "Bash(brew reinstall:*)",
      "Bash(brew tap:*)",
      "Bash(bun a *)",
      "Bash(bun add *)",
      "Bash(bun i:*)",
      "Bash(bun install:*)",
      "Bash(bundle add:*)",
      "Bash(bundle install:*)",
      "Bash(bunx:*)",
      "Bash(cargo add *)",
      "Bash(cargo install *)",
      "Bash(composer require:*)",
      "Bash(conda install:*)",
      "Bash(dotnet add:*)",
      "Bash(gem install:*)",
      "Bash(git commit *)",
      "Bash(go get *)",
      "Bash(go install *)",
      "Bash(go mod edit:*)",
      "Bash(mas install:*)",
      "Bash(npm add:*)",
      "Bash(npm i:*)",
      "Bash(npm install:*)",
      "Bash(npx:*)",
      "Bash(pip install:*)",
      "Bash(pip3 install:*)",
      "Bash(pipx install:*)",
      "Bash(pnpm add:*)",
      "Bash(pnpm i:*)",
      "Bash(pnpm install:*)",
      "Bash(poetry add:*)",
      "Bash(rustup component add:*)",
      "Bash(rustup target add:*)",
      "Bash(rustup toolchain install:*)",
      "Bash(swift package add-dependency *)",
      "Bash(uv add *)",
      "Bash(uv pip install *)",
      "Bash(uv run --with:*)",
      "Bash(uv tool install *)",
      "Bash(uvx:*)",
      "Bash(yarn add:*)",
      "Edit(//**/Brewfile)",
      "Edit(//**/requirements*.txt)",
      "Edit(//**/constraints.txt)",
      "Edit(//**/Package.swift)",
      "Edit(//**/.pre-commit-config.yaml)",
      "Edit(//**/uv.lock)",
      "Edit(//**/bun.lock)",
      "Edit(//**/bun.lockb)",
      "Edit(//**/Cargo.lock)",
      "Edit(//**/go.sum)",
      "Edit(//**/package-lock.json)",
      "Edit(//**/npm-shrinkwrap.json)",
      "Edit(//**/pnpm-lock.yaml)",
      "Edit(//**/yarn.lock)",
      "Edit(//**/Package.resolved)",
      "Edit(//**/Gemfile.lock)",
      "Edit(//**/poetry.lock)",
      "Edit(//**/composer.lock)",
      "Edit(//**/Pipfile.lock)",
      "Edit(//**/flake.lock)"
    ],
    "defaultMode": "auto"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "/opt/homebrew/bin/python3 \"$HOME/.claude/hooks/dependency_guard.py\"",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.sh",
    "padding": 0,
    "refreshInterval": 5
  },
  "enabledPlugins": {
    "gopls-lsp@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true,
    "rust-analyzer-lsp@claude-plugins-official": true,
    "swift-lsp@claude-plugins-official": true
  },
  "sandbox": {
    "enabled": true,
    "autoAllowBashIfSandboxed": true,
    "filesystem": {
      "allowWrite": [
        "/Users/shields/Library/Caches/go-build",
        "/Users/shields/Library/Caches/golangci-lint",
        "/Users/shields/go/pkg/mod",
        "/Users/shields/.cache/pre-commit",
        "/Users/shields/.cache/uv",
        "/Users/shields/.npm",
        "/Users/shields/.ruff_cache"
      ]
    }
  },
  "modelSettings": {
    "claude-opus-5": {
      "effortLevel": "xhigh"
    }
  },
  "awaySummaryEnabled": false,
  "skipWorkflowUsageWarning": true,
  "theme": "light",
  "verbose": true,
  "autoCompactEnabled": true
}
